{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "cause",
    "summary",
    "upstream_range",
    "reachability",
    "design_questions",
    "reasoning"
  ],
  "properties": {
    "classification": {
      "type": "string",
      "enum": [
        "mechanical",
        "no-impact",
        "needs-design"
      ]
    },
    "cause": {
      "type": "string",
      "enum": [
        "semantic-change",
        "new-feature",
        "compat-defect",
        "baseline-failure",
        "protected-path-edit",
        "incomplete-verification",
        "none"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "upstream_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "reachability": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "symbol",
              "reached",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "Exact changed upstream file path; each changed file must be covered once.",
                "pattern": "^[^/].*[^/]$|^[^/]$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "reached": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "symbol",
              "reached",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "Canonical directory path ending in /; covers all changed files under it exactly once. Empty coverage and overlaps are rejected.",
                "pattern": "^[^/].*/$"
              },
              "symbol": {
                "type": "string",
                "enum": [
                  "*"
                ]
              },
              "reached": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        ]
      }
    },
    "design_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
