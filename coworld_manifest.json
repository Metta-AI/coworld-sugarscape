{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": ["agent-based-model", "economics", "population-policy"],
  "game": {
    "name": "sugarscape",
    "version": "0.1.0",
    "description": "A native, deterministic DTL Sugarscape simulation where each player policy controls the movement choices of an assigned population.",
    "owner": "Metta-AI",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": ["tokens", "players", "slots"],
      "properties": {
        "tokens": {
          "description": "One authenticated WebSocket token per population slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1}
        },
        "players": {
          "description": "Display names indexed by population slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            }
          }
        },
        "slots": {
          "description": "Decision-model labels assigned to each population policy.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decisionModels"],
            "properties": {
              "token": {"type": "string"},
              "decisionModels": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "seed": {
          "description": "DTL-compatible seed; -1 selects and records an OS-random seed.",
          "type": "integer",
          "minimum": -1,
          "default": -1
        },
        "timesteps": {
          "type": "integer",
          "minimum": 1,
          "default": 200
        },
        "startingAgents": {
          "type": "integer",
          "minimum": 1,
          "default": 250
        },
        "agentDecisionModels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "decisionTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "connectionWaitMs": {
          "type": "integer",
          "minimum": 0,
          "default": 5000
        },
        "frameInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": ["names", "scores"],
      "properties": {
        "names": {
          "type": "array",
          "items": {"type": "string"}
        },
        "scores": {
          "type": "array",
          "items": {"type": "number"}
        }
      }
    },
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": ["/bin/sugarscape_coworld"],
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main"
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/coworld-protocol.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/coworld-protocol.md"
      },
      "engine_runtime": "bitworld"
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/README.md"
      },
      "pages": [
        {
          "id": "compatibility",
          "title": "Compatibility contract",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/rules.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "greedy",
      "name": "Sugarscape Greedy",
      "type": "player",
      "description": "Reference population policy that selects the DTL-compatible greedy-best candidate.",
      "image": "{{PLAYER_IMAGE}}",
      "run": ["/bin/sugarscape_greedy"],
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main/players/greedy"
    }
  ],
  "variants": [
    {
      "id": "default",
      "name": "Two-population Sugarscape",
      "description": "Two policy populations share a 32 by 32 sugar-and-spice world for 100 timesteps.",
      "game_config": {
        "seed": -1,
        "timesteps": 100,
        "startingAgents": 64,
        "environmentWidth": 32,
        "environmentHeight": 32,
        "agentDecisionModels": ["population-a", "population-b"],
        "connectionWaitMs": 5000,
        "decisionTimeoutMs": 100,
        "frameInterval": 1,
        "players": [
          {"name": "Population A"},
          {"name": "Population B"}
        ],
        "slots": [
          {"decisionModels": ["population-a"]},
          {"decisionModels": ["population-b"]}
        ]
      }
    }
  ],
  "certification": {
    "players": [
      {"player_id": "greedy"},
      {"player_id": "greedy"}
    ],
    "game_config": {
      "seed": 24680,
      "timesteps": 5,
      "startingAgents": 16,
      "environmentWidth": 16,
      "environmentHeight": 16,
      "agentDecisionModels": ["population-a", "population-b"],
      "connectionWaitMs": 5000,
      "decisionTimeoutMs": 100,
      "players": [
        {"name": "Population A"},
        {"name": "Population B"}
      ],
      "slots": [
        {"decisionModels": ["population-a"]},
        {"decisionModels": ["population-b"]}
      ]
    }
  },
  "players_per_user": 1,
  "episode_timeout_minutes": 15
}
