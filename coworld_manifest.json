{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "apiVersion": "coworld.softmax.com/v1",
  "tags": ["agent-based-model", "economics", "generative-social-science"],
  "game": {
    "name": "sugarscape",
    "description": "Grow a target social distribution by submitting one declarative SugarLang ruleset.",
    "owner": "Metta-AI",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": ["tokens", "players", "seats"],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1}
        },
        "players": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}}
          }
        },
        "seats": {"type": "integer", "minimum": 1, "maximum": 4},
        "seed": {"type": "integer", "minimum": -1, "default": -1},
        "timesteps": {"type": "integer", "minimum": 1, "default": 1000},
        "measurement_window": {"type": "integer", "minimum": 1, "default": 100},
        "startingAgents": {"type": "integer", "minimum": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": ["string", "object"]}
        },
        "trait_ranges": {"type": "object"},
        "ruleset_limits": {"type": "object"},
        "scenario_pool": {"type": "array", "minItems": 1},
        "player_connect_timeout_seconds": {"type": "number", "minimum": 0, "default": 180}
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scores",
        "details",
        "histograms",
        "timings",
        "score.match_mean",
        "score.match_min",
        "result.population_final",
        "result.gini_final",
        "result.extinct"
      ],
      "properties": {
        "scores": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "details": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
        "histograms": {"type": "object"},
        "timings": {"type": "object"},
        "score.match_mean": {"type": "number", "minimum": 0, "maximum": 1},
        "score.match_min": {"type": "number", "minimum": 0, "maximum": 1},
        "result.population_final": {"type": "integer", "minimum": 0},
        "result.gini_final": {"type": "number", "minimum": 0, "maximum": 1},
        "result.extinct": {"type": "boolean"},
        "result.timesteps_completed": {"type": "integer", "minimum": 0},
        "result.replay_raw_bytes": {"type": "integer", "minimum": 0},
        "result.replay_compressed_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": ["python", "-m", "coworld.server"],
      "env": {"PYTHONHASHSEED": "0"},
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main"
    },
    "replay_viewer": {"bundle": "build/replay-viewer"},
    "protocols": {
      "player": {"type": "uri", "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/PROTOCOL.md"},
      "global": {"type": "uri", "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/PROTOCOL.md"}
    },
    "docs": {
      "readme": {"type": "uri", "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/README.md"},
      "pages": [
        {"id": "rules", "title": "SugarLang rules", "content": {"type": "uri", "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/RULES.md"}},
        {"id": "targets", "title": "Target catalog", "content": {"type": "uri", "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/TARGETS.md"}}
      ]
    }
  },
  "player": [
    {
      "id": "baseline",
      "name": "Target-aware baseline",
      "type": "player",
      "description": "A readable canned SugarLang policy selected from the assigned target.",
      "image": "{{BASELINE_IMAGE}}",
      "run": ["python", "-m", "players.baseline.player"],
      "env": {"PYTHONHASHSEED": "0"},
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main/players/baseline"
    }
