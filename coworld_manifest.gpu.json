{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "apiVersion": "coworld.softmax.com/v1",
  "tags": [
    "agent-based-model",
    "economics",
    "generative-social-science",
    "cuda"
  ],
  "game": {
    "name": "sugarscape-research-gpu",
    "description": "Run the complete released FLAME GPU2 Sugarscape benchmark as a native reference experiment. Retain fixed native seeds, original model behavior and aggregate records.",
    "owner": "Metta-AI",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tokens",
        "players",
        "seats"
      ],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "seats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "seed": {
          "type": "integer",
          "minimum": -1,
          "default": -1
        },
        "timesteps": {
          "type": "integer",
          "minimum": 1,
          "default": 1000
        },
        "measurement_window": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "startingAgents": {
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "trait_ranges": {
          "type": "object"
        },
        "ruleset_limits": {
          "type": "object"
        },
        "scenario_pool": {
          "type": "array",
          "minItems": 1
        },
        "player_connect_timeout_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 180
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "study",
            "mode",
            "parameters"
          ],
          "properties": {
            "study": {
              "enum": [
                "richmond_2023"
              ]
            },
            "mode": {
              "enum": [
                "reference",
                "population-calibration"
              ]
            },
            "parameters": {
              "type": "object"
            },
            "target_population": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2500
            }
          }
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "score_method",
        "scores",
        "details",
        "histograms",
        "timings",
        "score.match_mean",
        "score.match_min",
        "result.population_final",
        "result.gini_final",
        "result.extinct",
        "rulesets_identical"
      ],
      "properties": {
        "score_method": {
          "enum": [
            "w1-hyperbolic/1",
            "wellness-sum/1",
            "research-reference/1",
            "research-population-calibration/1"
          ]
        },
        "scores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object"
          }
        },
        "histograms": {
          "type": "object"
        },
        "timings": {
          "type": "object"
        },
        "score.match_mean": {
          "type": "number",
          "minimum": 0
        },
        "score.match_min": {
          "type": "number",
          "minimum": 0
        },
        "result.population_final": {
          "type": "integer",
          "minimum": 0
        },
        "result.gini_final": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "result.extinct": {
          "type": "boolean"
        },
        "rulesets_identical": {
          "type": "boolean"
        },
        "result.timesteps_completed": {
          "type": "integer",
          "minimum": 0
        },
        "result.replay_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "result.replay_compressed_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "python",
        "-m",
        "coworld.server"
      ],
      "env": {
        "PYTHONHASHSEED": "0"
      },
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main",
      "resources": {
        "requests": {
          "gpu": 1,
          "cpu": "4",
          "memory": "4Gi",
          "ephemeral-storage": "15Gi"
        },
        "limits": {
          "cpu": "4",
          "memory": "8Gi"
        }
      }
    },
    "replay_viewer": {
      "bundle": "build/replay-viewer",
      "replay_compression": "gzip"
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/PROTOCOL.md\n\nResearch variants use sugarscape-research/1. Receive an observation with study, mode and parameter_schema; send {\"type\":\"action\",\"parameters\":{...}}. Fixed reference modes require an empty object. Calibration uses the closed observed schema. Seeds and auth tokens are withheld from player observations. Study sources and scientific qualifications are recorded in replay/details. A missing submission fails the episode; no reference completion is manufactured."
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/PROTOCOL.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules",
          "title": "SugarLang rules",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/RULES.md"
          }
        },
        {
          "id": "targets",
          "title": "Target catalog",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/TARGETS.md"
          }
        },
        {
          "id": "scenarios",
          "title": "Ladder scenario catalog",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/SCENARIOS.md"
          }
        },
        {
          "id": "getting-started",
          "title": "Getting started",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/getting-started.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "baseline",
      "name": "Target-aware baseline",
      "type": "player",
      "description": "A readable canned SugarLang policy selected from the assigned target.",
      "image": "{{BASELINE_IMAGE}}",
      "run": [
        "python",
        "-m",
        "players.baseline.player"
      ],
      "env": {
        "PYTHONHASHSEED": "0"
      },
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main/players/baseline"
    }
  ],
  "variants": [
    {
      "id": "paper-richmond-full",
      "name": "Richmond full released benchmark",
      "description": "Complete unmodified84-condition benchmark: native seeds0\u20132,48scaling and18occupation cases at100steps,18resolution cases at3steps. Source discrepancies remain unchanged. Episode seed is recorded but not substituted. Aggregate CSV replay; no historical V100 timing claim. Noncompetitive scorezero.",
      "game_config": {
        "seats": 1,
        "players": [
          {
            "name": "Research controller"
          }
        ],
        "timesteps": 100,
        "research": {
          "study": "richmond_2023",
          "mode": "reference",
          "parameters": {}
        }
      }
    }
  ],
  "certification": {
    "players": [
      {
        "player_id": "baseline"
      },
      {
        "player_id": "baseline"
      }
    ],
    "game_config": {
      "seed": 1729,
      "seats": 2,
      "players": [
        {
          "name": "Baseline 1"
        },
        {
          "name": "Baseline 2"
        }
      ],
      "timesteps": 50,
      "measurement_window": 10,
      "replay_histogram_interval": 5,
      "startingAgents": 30,
      "startingDiseases": 0,
      "environmentWidth": 20,
      "environmentHeight": 20,
      "environmentSugarPeaks": [
        [
          5,
          14,
          4
        ],
        [
          14,
          5,
          4
        ]
      ],
      "environmentSpicePeaks": [
        [
          5,
          5,
          4
        ],
        [
          14,
          14,
          4
        ]
      ],
      "targets": [
        "wealth.skewed-gini-0.5",
        "wealth.egalitarian"
      ]
    }
  },
  "players_per_user": 1,
  "episode_timeout_minutes": 35
}
