{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": ["agent-based-model", "economics", "multi-player"],
  "game": {
    "name": "sugarscape",
    "version": "0.1.7",
    "description": "A native, deterministic DTL Sugarscape simulation where each player policy controls one agent.",
    "owner": "Metta-AI",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": ["tokens", "players"],
      "properties": {
        "tokens": {
          "description": "One authenticated WebSocket token per player seat.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1}
        },
        "players": {
          "description": "Display names indexed by player seat.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            }
          }
        },
        "slots": {
          "description": "Decision-model labels assigned to each population policy.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decisionModels"],
            "properties": {
              "token": {"type": "string"},
              "decisionModels": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "seed": {
          "description": "DTL-compatible seed; -1 selects and records an OS-random seed.",
          "type": "integer",
          "minimum": -1,
          "default": -1
        },
        "timesteps": {
          "type": "integer",
          "minimum": 1,
          "default": 200
        },
        "startingAgents": {
          "type": "integer",
          "minimum": 1,
          "default": 250
        },
        "agentDecisionModels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "decisionTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "connectionWaitMs": {
          "description": "Maximum startup wait for every player seat to connect.",
          "type": "integer",
          "minimum": 0,
          "default": 180000
        },
        "frameInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "onePlayerPerAgent": {
          "description": "Assign seat N exclusively to initial agent N and require one seat per starting agent.",
          "type": "boolean",
          "default": false
        },
        "playerTribes": {
          "description": "Assign each player seat a fixed combat tribe.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": true,
      "required": ["names", "scores"],
      "properties": {
        "names": {
          "type": "array",
          "items": {"type": "string"}
        },
        "scores": {
          "type": "array",
          "items": {"type": "number"}
        }
      }
    },
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": ["/bin/sugarscape_coworld"],
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main"
    },
    "replay_viewer": {
      "bundle": "build/static-replay-viewer"
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/coworld-protocol.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/docs/coworld-protocol.md"
      },
      "engine_runtime": "bitworld"
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/README.md"
      },
      "pages": [
        {
          "id": "compatibility",
          "title": "Compatibility contract",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-sugarscape/blob/main/rules.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "greedy",
      "name": "Sugarscape Greedy",
      "type": "player",
      "description": "Reference player policy that selects the DTL-compatible greedy-best candidate.",
      "image": "{{PLAYER_IMAGE}}",
      "run": ["/bin/sugarscape_greedy"],
      "source_url": "https://github.com/Metta-AI/coworld-sugarscape/tree/main/players/greedy"
